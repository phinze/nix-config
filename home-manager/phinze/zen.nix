{
  pkgs,
  lib,
  ...
}:
let
  # Zen Space Routing: which space (and so which container) a URL opens in.
  # This is what puts mirendev links from Slack or the terminal into the Miren
  # space; finicky just hands everything to Zen and stays out of it. Spaces are
  # named as they appear in Zen's sidebar and resolved to UUIDs at activation.
  # First match wins. `match` is one of contains, equal-to, or regex.
  spaceRouting = {
    routes = [
      {
        match = "regex";
        url = ''^https://github\.com/mirendev(/|$)'';
        space = "Miren";
      }
      {
        match = "regex";
        url = ''^https://github\.com/phinze(/|$)'';
        space = "Personal";
      }
    ];
    # Where external links matching no route go: a space name, or
    # most-recent-space for whichever space was last active.
    defaultExternal = "most-recent-space";
  };

  # about:config prefs, written to the profile's user.js. Zen applies these at
  # every startup, so changing one in Settings only lasts until the next
  # launch. Removing a line here does not reset the pref; reset it in
  # about:config.
  prefs = {
    # Spaces force their container. Space routing relies on this to land
    # routed tabs in the right container.
    "zen.workspaces.force-container-workspace" = true;
    "zen.view.compact.enable-at-startup" = false;
    "sidebar.visibility" = "hide-launcher";
    "findbar.highlightAll" = true;
    "accessibility.typeaheadfind.flashBar" = 0;

    # No speculative DNS lookups, link prefetching, or preconnects.
    "network.dns.disablePrefetch" = true;
    "network.prefetch-next" = false;
    "network.http.speculative-parallel-limit" = 0;

    # 1Password handles passwords, addresses, and cards, so Zen should neither
    # offer to save them nor sync them.
    "signon.rememberSignons" = false;
    "extensions.formautofill.addresses.enabled" = false;
    "extensions.formautofill.creditCards.enabled" = false;
    "browser.formfill.enable" = false;
    "services.sync.engine.passwords" = false;
    "services.sync.engine.addresses" = false;
    "services.sync.engine.creditcards" = false;

    "browser.urlbar.suggest.searches" = false;
    "browser.urlbar.suggest.engines" = false;

    # Clear on shutdown, but keep cookies, history, and downloads.
    "privacy.sanitize.sanitizeOnShutdown" = true;
    "privacy.clearOnShutdown_v2.cookiesAndStorage" = false;
    "privacy.clearOnShutdown_v2.browsingHistoryAndDownloads" = false;
    "privacy.clearOnShutdown_v2.historyFormDataAndDownloads" = false;

    "devtools.netmonitor.persistlog" = true;
    "devtools.webconsole.persistlog" = true;
    "devtools.responsive.reloadNotification.enabled" = false;
  };

  routesJson = pkgs.writeText "zen-space-routing.json" (builtins.toJSON spaceRouting);

  userJs = pkgs.writeText "user.js" (
    "// Generated by nix-config (home-manager/phinze/zen.nix); edits are overwritten.\n"
    + lib.concatStrings (
      lib.mapAttrsToList (name: value: "user_pref(${builtins.toJSON name}, ${builtins.toJSON value});\n") prefs
    )
  );

  zen-profile = pkgs.writeShellScriptBin "zen-profile" ''
    if [ "$1" = apply ]; then
      exec ${pkgs.python3}/bin/python3 ${./zen-profile.py} apply ${routesJson} ${userJs}
    fi
    exec ${pkgs.python3}/bin/python3 ${./zen-profile.py} "$@"
  '';
in
lib.mkIf pkgs.stdenv.hostPlatform.isDarwin {
  home.packages = [ zen-profile ];

  # Zen owns the routing file and rewrites it from memory whenever its routing
  # dialog saves, so a symlink would be clobbered and a write under a running
  # Zen would be lost. zen-profile skips the routes (and says so) while Zen is
  # up; quit Zen and run `zen-profile apply` to pick up a change. Routes added
  # through the dialog are dropped on the next apply: declare them here.
  # user.js is written every time, since Zen only reads it at startup.
  home.activation.zenProfile = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
    $DRY_RUN_CMD ${zen-profile}/bin/zen-profile apply
  '';
}
